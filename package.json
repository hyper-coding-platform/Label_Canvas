{
  "name": "@your-org/erp-label-studio",
  "version": "0.1.0",
  "description": "Embeddable label designer, deterministic label renderer and barcode SDK for React and Next.js ERP applications.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "default": "./dist/renderer.js"
    },
    "./headless": {
      "types": "./dist/headless.d.ts",
      "default": "./dist/headless.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "default": "./dist/presets.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/CHANGELOG.md"
  ],
  "keywords": [
    "label",
    "barcode",
    "qr-code",
    "erp",
    "react",
    "nextjs",
    "label-designer",
    "gs1"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsup && node scripts/post-build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --project unit --project integration --project security",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:security": "vitest run --project security",
    "test:coverage": "vitest run --project unit --project integration --project security --coverage",
    "test:browser": "npm run build && playwright test --project=chromium",
    "bench": "npm run build && node --expose-gc scripts/bench.mjs",
    "size": "size-limit",
    "check:package": "publint --strict && attw --pack . --profile esm-only --exclude-entrypoints styles.css",
    "test:pack": "node scripts/test-pack.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:package && npm run size",
    "test:browser:all": "npm run build && playwright test",
    "test:nextjs": "node scripts/test-pack.mjs && playwright test -c playwright.nextjs.config.ts",
    "bench:editor": "npm run build && playwright test -c playwright.perf.config.ts",
    "check:licenses": "node scripts/check-licenses.mjs",
    "audit:prod": "npm audit --omit=dev",
    "pack:local": "node scripts/test-pack.mjs --pack-only",
    "playground": "npm run pack:local && npm --prefix examples/nextjs-playground install --no-audit --no-fund && npm --prefix examples/nextjs-playground run dev"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20.0.0",
    "react-dom": ">=18.2.0 <20.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@size-limit/esbuild": "13.1.1",
    "@size-limit/file": "13.1.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "4.14.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "size-limit": "12.1.0",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "zxing-wasm": "3.1.6"
  }
}
